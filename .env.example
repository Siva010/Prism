# --- Upstream providers ---
ANTHROPIC_API_KEY=sk-ant-...
# Secondary provider (failover + different-family judge). Week 10-11.
# OPENAI_API_KEY=

# --- Datastores ---
PRISM_DATABASE_URL=postgresql+asyncpg://prism:prism@localhost:5434/prism
PRISM_REDIS_URL=redis://localhost:6380/0

# --- Gateway behaviour ---
PRISM_DEFAULT_MODEL=claude-opus-5
PRISM_DEFAULT_MAX_TOKENS=4096
PRISM_REQUEST_TIMEOUT_S=600
PRISM_FIRST_TOKEN_TIMEOUT_S=30
PRISM_LOG_LEVEL=INFO
# Persist full request/response bodies on traces. Disable in shared environments.
PRISM_TRACE_BODIES=true

# --- Evaluation harness (weeks 4-6) ---
# The judge MUST be a different model family from the system under test:
# Prism serves Claude on every tier, so a Claude judge would score its own
# family higher. clients.assert_different_family() refuses one outright.
PRISM_JUDGE_MODEL=gpt-4o-mini
PRISM_JUDGE_API_KEY=
PRISM_JUDGE_BASE_URL=https://api.openai.com/v1
# Where scripts/eval.py points its arms.
PRISM_URL=http://localhost:8000
PRISM_API_KEY=prism_sk_...

# --- Layer 1: provider prefix cache (week 7) ---
PRISM_CACHE_ENABLED=true
# 5m or 1h. A 1h write costs 2x the base input rate instead of 1.25x.
PRISM_CACHE_TTL=5m
# History is per-conversation, so this only pays back on multi-turn traffic.
PRISM_CACHE_CONVERSATION_PREFIX=false
# Set false if tool descriptions are built from customer data — nothing in the
# code can detect that, and a shared prefix containing tenant data is a leak.
PRISM_CACHE_TRUST_TOOLS=true
PRISM_PROMPTS_ROOT=prompts

# --- Layer 2: semantic cache (week 8) ---
# Off until a threshold has been calibrated. Unlike layer 1, this layer can
# return a WRONG answer, so it does not get a convenient default.
#   python scripts/calibrate_cache.py --pairs datasets/cache_pairs.jsonl
PRISM_SEMANTIC_CACHE_ENABLED=false
PRISM_SEMANTIC_CACHE_THRESHOLD=0.95
# "local" loads bge-small-en-v1.5 on CPU (needs the [embeddings] extra);
# "hashing" is a test stub the cache refuses to serve traffic on.
PRISM_EMBEDDER=local
PRISM_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
PRISM_SEMANTIC_CACHE_MIN_QUERY_CHARS=24
PRISM_HNSW_EF_SEARCH=40

# --- Two-axis router (week 9) ---
# Engaged only for requests naming the model "prism-auto"; every other model
# name is served as asked.  python scripts/train_router.py --demo
PRISM_ROUTER_ENABLED=false
PRISM_ROUTER_MODEL_PATH=data/router.joblib
# none | verify_then_escalate. With escalation the break-even threshold is the
# cost ratio; without it, money always favours the cheap tier and the quality
# floor binds instead.
PRISM_ROUTER_MODE=verify_then_escalate
PRISM_ROUTER_QUALITY_FLOOR=0.85
PRISM_ROUTER_VERIFIER_FRACTION=0.0

# --- Resilience and governance (weeks 10-11) ---
# Three-dimensional token-aware limiting. Needs Redis; when off, the provider's
# own 429s are the only backstop.
PRISM_RATE_LIMIT_ENABLED=false
PRISM_RATE_LIMIT_SAFETY_MARGIN=0.15
PRISM_BREAKER_FAILURE_THRESHOLD=5
PRISM_BREAKER_COOLDOWN_SECONDS=30
# Hedging pays for two completions and keeps one, so it is opt-in and capped.
PRISM_HEDGE_ENABLED=false
PRISM_HEDGE_DELAY_MS=2000
PRISM_HEDGE_MAX_COST_USD=0.05
# Per-tenant caps from the tenant_budgets table; a tenant with no row is
# unlimited.
PRISM_BUDGETS_ENABLED=true
