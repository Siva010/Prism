// --- NOT equivalent: same topic, unrelated request -----------------------
{"query_a": "Explain what a database index does", "query_b": "Write a SQL query that creates an index on the users table", "equivalent": false, "notes": "explain vs do"}
{"query_a": "What is machine learning?", "query_b": "Write a Python script that trains a linear regression model", "equivalent": false}
{"query_a": "Tell me about the history of coffee", "query_b": "How much caffeine is in a cup of coffee?", "equivalent": false}
{"query_a": "Review this paragraph for grammar mistakes", "query_b": "Translate this paragraph into Spanish", "equivalent": false}
{"query_a": "What is my current account balance?", "query_b": "What is the current interest rate on savings accounts?", "equivalent": false, "notes": "tenant-specific vs general -- scope keys catch this too"}
